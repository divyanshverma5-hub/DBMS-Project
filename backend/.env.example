# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL — use a dedicated least-privilege account where possible
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_database_password
DB_NAME=music_mood_db

# Generate a random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_bytes_of_random_data
JWT_EXPIRES_IN=7d

# Tracks heard within this many days are excluded (integer from 1 to 3650)
RECOMMENDATION_RECENT_DAYS=30
